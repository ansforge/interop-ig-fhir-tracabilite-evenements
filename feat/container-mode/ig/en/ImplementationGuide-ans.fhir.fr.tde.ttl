         fhir:reference [ fhir:v "CapabilityStatement/TdESource" ]
       ] ;
       fhir:name [ fhir:v "TdE-Source" ] ;
       fhir:description [ fhir:v "Le rôle de la Source est de transmettre les informations de traçabilité relatives à une étape significative d'un processus métier suite à un événement au gestionnaire." ] ;

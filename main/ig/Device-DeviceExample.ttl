# - resource -------------------------------------------------------------------

<https://interop.esante.gouv.fr/ig/fhir/tde/Device/DeviceExample> a fhir:Device ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "DeviceExample"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Device DeviceExample</b></p><a name=\"DeviceExample\"> </a><a name=\"hcDeviceExample\"> </a><p><b>manufacturer</b>: Éditeur SI Santé</p><h3>DeviceNames</h3><table class=\"grid\"><tr><td style=\"display: none\">-</td><td><b>Name</b></td><td><b>Type</b></td></tr><tr><td style=\"display: none\">*</td><td>SIH</td><td>User Friendly name</td></tr></table></div>"
  ] ;
  fhir:Device.manufacturer [ fhir:value "Éditeur SI Santé"] ;
  fhir:Device.deviceName [
     fhir:index 0 ;
     fhir:Device.deviceName.name [ fhir:value "SIH" ] ;
     fhir:Device.deviceName.type [ fhir:value "user-friendly-name" ]
  ] .


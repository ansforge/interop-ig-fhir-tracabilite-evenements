       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "TdE-Gestionnaire" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Le rôle du Gestionnaire est d'enregistrer les informations de traçabilité et fournir les traces en cas de consultation ou de recherches.\nLe gestionnaire des traces peut être, par exemple, un logiciel de traçabilité ou le module de traçabilité d'un logiciel métier." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.extension [
         fhir:index 0 ;

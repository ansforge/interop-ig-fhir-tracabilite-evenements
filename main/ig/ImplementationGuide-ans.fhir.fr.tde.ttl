       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Paramètre de recherche créé pour le volet TdE de manière à pouvoir utiliser comme critère de recherche l'élément AuditEvent.period.start correspondant à l'objet dateOccurence" ] ;

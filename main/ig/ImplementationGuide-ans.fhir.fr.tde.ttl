       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "TdE-Source" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Le rôle de la Source est de transmettre les informations de traçabilité relatives à une étape significative d'un processus métier suite à un événement au gestionnaire." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
